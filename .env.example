# Copy to .env and edit. Nothing here is required for the offline test suite.

# Model. Default provider is Bedrock; enable Anthropic Claude model access in the Bedrock console first.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Optional fallback for local runs without AWS: MODEL_PROVIDER=anthropic plus an API key.
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# Demo clock. Tools compute "tomorrow", shift ages and expiry windows relative to this date.
DEMO_TODAY=2026-09-11

# Web console backend: local (agents run in-process) or agentcore (calls the deployed runtime).
AGENT_BACKEND=local
# AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/PantryPilotAgent-xxxx

# Scheduler: seconds between automatic sweeps (0 disables); run one sweep when the server starts.
SWEEP_INTERVAL_SECONDS=900
SWEEP_ON_START=0

# Sessions: FileSessionManager under .data/sessions by default; set a bucket to use S3SessionManager.
# SESSION_BUCKET=
# SESSION_PREFIX=pantrypilot/sessions

LOG_LEVEL=INFO
